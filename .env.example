# Backend configuration. Copy to .env. Defaults are intended for local development.
# Prefix: FLOWSTATE_

FLOWSTATE_ENVIRONMENT=development
FLOWSTATE_LOG_LEVEL=INFO
FLOWSTATE_LOG_JSON=true

# Runtime state. SQLite lives at $FLOWSTATE_DATA_DIR/flowstate.db.
FLOWSTATE_DATA_DIR=.flowstate
# FLOWSTATE_DATABASE_URL=sqlite:////absolute/path/to/flowstate.db

# CORS must include the exact origin the console is served from.
FLOWSTATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset for local development. Every non-health route requires
# "Authorization: Bearer <token>" when configured.
# Deployed environments require both values to be explicitly set to at least
# 32 characters and reject loopback CORS origins.
# FLOWSTATE_API_TOKEN=replace-with-a-random-32-character-or-longer-token
# FLOWSTATE_SECRET_KEY=replace-with-a-random-32-character-or-longer-secret
# FLOWSTATE_API_ACTOR_KIND=AGENT
# FLOWSTATE_API_ACTOR_ROLE=OPERATOR

FLOWSTATE_DEMO_SEED_ENABLED=true
FLOWSTATE_AUTO_SEED_DEMO=true
FLOWSTATE_DECISION_TTL_SECONDS=600
FLOWSTATE_RUN_ACTION_BUDGET=64

# Workflow learning. Only this controlled demo may be recorded or replayed.
FLOWSTATE_DEMO_APP_URL=http://127.0.0.1:8000/demo-app/
FLOWSTATE_CAPTURE_ENABLED=true
FLOWSTATE_CAPTURE_MAX_EVENTS=80
FLOWSTATE_BROWSER_TIMEOUT_MS=8000

# Alan adapter (custom MCP connector or CLI). The backend token is a secret;
# never pass it as a tool argument.
FLOWSTATE_API_URL=http://127.0.0.1:8000/api/v1
# FLOWSTATE_API_TOKEN=
FLOWSTATE_ALAN_ACTOR=alan-operator
FLOWSTATE_ALAN_ROLE=OPERATOR
FLOWSTATE_ALAN_ACTOR_KIND=HUMAN
FLOWSTATE_ALAN_TIMEOUT_SECONDS=30
FLOWSTATE_ALAN_RETRIES=2
# Inbound bearer token for the streamable HTTP MCP connector. Required for a
# non-loopback bind.
# FLOWSTATE_ALAN_MCP_TOKEN=
FLOWSTATE_ALAN_MCP_HOST=127.0.0.1
FLOWSTATE_ALAN_MCP_PORT=8765
# Set true to expose read-only tools only.
FLOWSTATE_ALAN_READ_ONLY=false
# Optional comma-separated workflow ids/slugs/names the adapter may resolve.
# FLOWSTATE_ALAN_ALLOWED_WORKFLOWS=invoice-approval,vendor-payout
