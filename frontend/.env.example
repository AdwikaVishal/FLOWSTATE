# Frontend configuration. Copy to .env.local when overriding the defaults.
# By default the browser calls /api/v1 on the same origin and Vite proxies it.

# Point the console at a different API origin (e.g. a deployed backend).
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Only needed when the backend is started with FLOWSTATE_API_TOKEN.
# VITE_API_TOKEN=

# Development proxy target used by `npm run dev` and `npm run preview`.
# VITE_PROXY_TARGET=http://127.0.0.1:8000